<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FishCues</AssemblyName>
    <RootNamespace>FishCues</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Game location. Override with -p:VALHEIM_INSTALL="D:\SteamLibrary\steamapps\common\Valheim" -->
  <PropertyGroup>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">C:\Program Files\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <ValheimManaged>$(VALHEIM_INSTALL)/valheim_Data/Managed</ValheimManaged>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(VALHEIM_INSTALL)/BepInEx/core</BepInExPath>
  </PropertyGroup>

  <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManaged)/assembly_valheim.dll')"
           Text="Valheim assemblies not found in '$(ValheimManaged)'. Point VALHEIM_INSTALL at your game folder." />
    <Error Condition="!Exists('$(BepInExPath)/BepInEx.dll')"
           Text="BepInEx not found in '$(BepInExPath)'. Install BepInExPack_Valheim into the game folder." />
  </Target>

  <ItemGroup>
    <!-- Build-time only. Lets net472 build without the targeting pack installed; the publicizer
         rewrites privates into copies under obj/, so the shipped DLL binds to the real game
         members and runs on an unmodified game install. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game's netstandard (2.1). Without it Unity 6's modules fail to compile against the
         2.0 facade from the targeting pack (CS1705). -->
    <Reference Include="netstandard" HintPath="$(ValheimManaged)/netstandard.dll" Private="false" />

    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)/assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="UnityEngine"             HintPath="$(ValheimManaged)/UnityEngine.dll"             Private="false" />
    <Reference Include="UnityEngine.CoreModule"  HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll"  Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ValheimManaged)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="BepInEx"  HintPath="$(BepInExPath)/BepInEx.dll"  Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExPath)/0Harmony.dll" Private="false" />
  </ItemGroup>

</Project>
